{"id":"adv-open-named","key":"adventure-open","note":"the named opener loads the shipped world and announces the opening room","turns":["play ashcombe hall"],"expect":[{"turn":0,"mode":"regex","value":"adventure begins"},{"turn":0,"mode":"regex","value":"study"}]}
{"id":"adv-open-generic","key":"adventure-open","note":"the generic opener resolves to the pack's only world","turns":["start the adventure"],"expect":[{"turn":0,"mode":"regex","value":"adventure begins"},{"turn":0,"mode":"regex","value":"study"}]}
{"id":"adv-open-title-case","key":"adventure-open","note":"the spoken title-case name folds onto the pack's hyphenated world name","turns":["play Ashcombe Hall"],"expect":[{"turn":0,"mode":"regex","value":"adventure begins"}]}
{"id":"adv-open-already-playing","key":"adventure-open","note":"a second opener mid-adventure declines and the running world stands","turns":["play ashcombe hall","play ashcombe hall"],"expect":[{"turn":1,"mode":"regex","value":"already playing ashcombe hall"}]}
{"id":"adv-stop","key":"adventure-stop","note":"stop playing ends the adventure and says the world's facts stay","turns":["start the adventure","stop playing"],"expect":[{"turn":1,"mode":"regex","value":"the adventure ends"},{"turn":1,"mode":"regex","value":"stays? remembered"}]}
{"id":"adv-missing-pack","key":"adventure-open","note":"an absent worlds pack is an honest decline that names the pack, never a silent fall-through","setup":{"env":{"TMCT_WORLDS_PACK_DIR":"/nonexistent-tmct-worlds-pack"}},"turns":["start the adventure"],"expect":[{"turn":0,"mode":"regex","value":"no worlds pack here"},{"turn":0,"mode":"regex","value":"corpus/worlds"}]}
{"id":"adv-unknown-play-falls-through","key":"adventure-open","note":"a \"play X\" naming no shipped world is not the adventure's to claim","turns":["play chess"],"expect":[{"turn":0,"mode":"predicate","value":{"name":"answerLacks","arg":"worlds pack"}},{"turn":0,"mode":"predicate","value":{"name":"answerLacks","arg":"adventure begins"}}]}
{"id":"adv-slot-guards-number-game","key":"adventure-slot","note":"the plan slot holds one thing at a time, both directions across adventure and guess-the-number","turns":["play ashcombe hall","guess my number","stop playing","i'm thinking of a number","play ashcombe hall"],"expect":[{"turn":1,"mode":"regex","value":"mid-adventure"},{"turn":3,"mode":"regex","value":"My guess"},{"turn":4,"mode":"regex","value":"guess-the-number game is active"}]}
{"id":"adv-memory-carries-world-provenance","key":"adventure-load","note":"loaded world facts are auditable in /memory under world:ashcombe-hall provenance","turns":["play ashcombe hall","/memory verbose"],"expect":[{"turn":1,"mode":"regex","value":"cabinet mgx:stands-locked-in study"},{"turn":1,"mode":"regex","value":"world:ashcombe-hall"}]}
{"id":"adv-look-cites-lock-hides-key","key":"adventure-look","note":"the opening look is an extractive digest that cites the locked cabinet and never the hidden key","turns":["play ashcombe hall","look"],"expect":[{"turn":1,"mode":"regex","value":"[Cc]abinet stands locked in the study"},{"turn":1,"mode":"regex","value":"exit north to the library"},{"turn":1,"mode":"predicate","value":{"name":"answerLacks","arg":"key"}}]}
{"id":"adv-go-declines-missing-exit","key":"adventure-move","note":"a direction with no exit fact declines by name, never a silent no-op","turns":["play ashcombe hall","go east"],"expect":[{"turn":1,"mode":"regex","value":"no exit east from the study"}]}
{"id":"adv-go-moves-and-look-names-portrait","key":"adventure-move","note":"movement writes the player snapshot and the drawing-room look mentions the portrait, not its hidden key","turns":["play ashcombe hall","go north","go north","look"],"expect":[{"turn":1,"mode":"regex","value":"[Nn]ow in the library"},{"turn":2,"mode":"regex","value":"[Nn]ow in the drawing-room"},{"turn":3,"mode":"regex","value":"[Pp]ortrait is fixed in the drawing-room"},{"turn":3,"mode":"predicate","value":{"name":"answerLacks","arg":"key"}}]}
{"id":"adv-take-hidden-is-unseen","key":"adventure-take","note":"a hidden object reads as absent — hidden means hidden, never revealed by a decline","turns":["play ashcombe hall","take the key"],"expect":[{"turn":1,"mode":"regex","value":"don't see a key here"}]}
{"id":"adv-take-fixed-declines-by-name","key":"adventure-take","note":"taking a fixed-in-place object is a specific precondition decline, not silence","turns":["play ashcombe hall","go north","go north","take the portrait"],"expect":[{"turn":3,"mode":"regex","value":"portrait is fixed in place"}]}
{"id":"adv-open-locked-declines","key":"adventure-container","note":"opening a locked container names the lock","turns":["play ashcombe hall","open the cabinet"],"expect":[{"turn":1,"mode":"regex","value":"cabinet is locked"}]}
{"id":"adv-unlock-requires-carried-instrument","key":"adventure-unlock","note":"unlock's carried-instrument precondition declines by name","turns":["play ashcombe hall","unlock the cabinet with the key"],"expect":[{"turn":1,"mode":"regex","value":"not carrying the key"}]}
{"id":"adv-unlock-without-instrument-asks","key":"adventure-unlock","note":"a bare unlock asks what to use, never guesses the instrument","turns":["play ashcombe hall","unlock the cabinet"],"expect":[{"turn":1,"mode":"regex","value":"with what"}]}
{"id":"adv-wrong-instrument-declines","key":"adventure-unlock","note":"a carried but wrong instrument declines naming the mismatch","turns":["play ashcombe hall","take the lamp","unlock the cabinet with the lamp"],"expect":[{"turn":2,"mode":"regex","value":"lamp doesn't fit the cabinet"}]}
{"id":"adv-open-reveals-hidden-contents","key":"adventure-container","note":"opening a container reveals and frees its hidden contents; the inventory digest then carries them","turns":["play ashcombe hall","go north","go north","open the portrait","take the key","what am i carrying"],"expect":[{"turn":3,"mode":"regex","value":"inside: the key"},{"turn":4,"mode":"regex","value":"you take the key"},{"turn":5,"mode":"regex","value":"[Pp]layer carries the key"}]}
{"id":"adv-drop-lands-in-current-room","key":"adventure-take","note":"drop writes the object into the current room and the next look shows it there","turns":["play ashcombe hall","take the lamp","go north","drop the lamp","look"],"expect":[{"turn":3,"mode":"regex","value":"you drop the lamp in the library"},{"turn":4,"mode":"regex","value":"[Ll]amp is in the library"}]}
{"id":"adv-drop-not-carried-declines","key":"adventure-take","note":"dropping what you don't hold declines by name","turns":["play ashcombe hall","drop the letter"],"expect":[{"turn":1,"mode":"regex","value":"not carrying the letter"}]}
{"id":"adv-give-requires-presence","key":"adventure-give","note":"give needs the receiver in the room; a present receiver takes the object","turns":["play ashcombe hall","take the lamp","give the lamp to the housekeeper","go north","go east","give the lamp to the cook"],"expect":[{"turn":2,"mode":"regex","value":"housekeeper isn't here"},{"turn":5,"mode":"regex","value":"you give the lamp to the cook"}]}
{"id":"adv-close-after-open","key":"adventure-container","note":"close flips an open container and declines on a closed one","turns":["play ashcombe hall","go north","go north","open the portrait","close the portrait","close the portrait"],"expect":[{"turn":4,"mode":"regex","value":"you close the portrait"},{"turn":5,"mode":"regex","value":"portrait isn't open"}]}
{"id":"adv-unknown-word-named","key":"adventure-miss","note":"an undeclared word in a command is named, never guessed around","turns":["play ashcombe hall","take the blunderbuss"],"expect":[{"turn":1,"mode":"regex","value":"don't know the word \"blunderbuss\""}]}
{"id":"adv-aside-falls-through","key":"adventure-aside","note":"a mid-game aside is an ordinary turn — the teach lane still stores it, world untouched","turns":["play ashcombe hall","remember the lamp is brassy"],"expect":[{"turn":1,"mode":"regex","value":"noted — remembered"}]}
{"id":"adv-empty-inventory-honest","key":"adventure-look","note":"an empty inventory is the honest empty answer, not a fabricated list","turns":["play ashcombe hall","what am i carrying"],"expect":[{"turn":1,"mode":"regex","value":"aren't carrying anything"}]}
{"id":"adv-worked-example-full","key":"adventure-worked-example","note":"the country-house mystery start to finish: every intermediate state, every named decline, and the housekeeper's turn-3 move observed on the return to the library","turns":["play ashcombe hall","look","go north","go north","look","take the portrait","open the portrait","take the key","go south","look","go south","unlock the cabinet with the key","open the cabinet","take the letter"],"expect":[{"turn":1,"mode":"regex","value":"[Cc]abinet stands locked in the study"},{"turn":1,"mode":"predicate","value":{"name":"answerLacks","arg":"key"}},{"turn":2,"mode":"regex","value":"[Nn]ow in the library"},{"turn":3,"mode":"regex","value":"[Nn]ow in the drawing-room"},{"turn":4,"mode":"regex","value":"[Pp]ortrait is fixed in the drawing-room"},{"turn":4,"mode":"predicate","value":{"name":"answerLacks","arg":"key"}},{"turn":5,"mode":"regex","value":"portrait is fixed in place"},{"turn":6,"mode":"regex","value":"you open the portrait — inside: the key"},{"turn":7,"mode":"regex","value":"you take the key"},{"turn":8,"mode":"regex","value":"[Nn]ow in the library"},{"turn":9,"mode":"regex","value":"[Hh]ousekeeper is in the library"},{"turn":10,"mode":"regex","value":"[Nn]ow in the study"},{"turn":11,"mode":"regex","value":"you unlock the cabinet with the key"},{"turn":12,"mode":"regex","value":"you open the cabinet — inside: the letter"},{"turn":13,"mode":"regex","value":"you take the letter"}]}
{"id":"adv-npc-move-observed-arriving","key":"adventure-npc","note":"an NPC arriving in the player's room on its scheduled turn is announced with the move","turns":["play ashcombe hall","go north","go east","go west"],"expect":[{"turn":3,"mode":"regex","value":"[Nn]ow in the library"},{"turn":3,"mode":"regex","value":"housekeeper walks in"}]}
{"id":"adv-npc-move-observed-leaving","key":"adventure-npc","note":"an NPC leaving the player's room on its scheduled turn is announced too","turns":["play ashcombe hall","take the lamp","go north","go east"],"expect":[{"turn":3,"mode":"regex","value":"[Nn]ow in the kitchen"},{"turn":3,"mode":"regex","value":"housekeeper leaves"}]}
{"id":"adv-where-aside-reads-the-current-fold","key":"adventure-aside","note":"a mid-game 'where is X' reads the current world fold, not the raw base rows — the housekeeper's scheduled move answers with her current room, never the stale load-time placement","turns":["play ashcombe hall","go north","go south","go north","where is the housekeeper"],"expect":[{"turn":3,"mode":"regex","value":"housekeeper walks in"},{"turn":4,"mode":"regex","value":"housekeeper is in the library"},{"turn":4,"mode":"predicate","value":{"name":"answerLacks","arg":["kitchen","i learned"]}}]}
{"id":"adv-where-aside-hides-hidden-and-reads-carried","key":"adventure-aside","note":"the where-aside never reveals a hidden thing's hiding place, and a carried thing reads as carried","turns":["play ashcombe hall","where is the key","take the lamp","where is the lamp"],"expect":[{"turn":1,"mode":"regex","value":"nothing you've seen says where the key is"},{"turn":1,"mode":"predicate","value":{"name":"answerLacks","arg":["portrait"]}},{"turn":3,"mode":"regex","value":"you are carrying the lamp"}]}
