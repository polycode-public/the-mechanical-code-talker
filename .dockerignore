# The image only ever COPYs server/*/dist/handler.mjs and server/seeds/*.sqlite
# from the build context. Everything else here is source, tests, docs, or
# dev tooling the build never touches. Trimming the context keeps `docker
# build` from packing the whole repo (corpus/, test fixtures, node_modules)
# across to the daemon on every build.
.git/
.github/
.claude/
.idea/

node_modules/

corpus/
data/
docs/
examples/
ontology/
playtests/
public/
reports/
results/
scripts/
test/
test-benchmarks/
test-capture/
test-e2e/
backlog/
archive/
clips/
demo/
infra/

*.md
*.log
