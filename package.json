{
  "name": "@polycode-projects/the-mechanical-code-talker",
  "version": "6.0.3",
  "private": false,
  "type": "module",
  "description": "The Mechanical Code Talker (tmct) — a tolerant, offline, $0 chat surface that guides you toward precision queries about a software repository. ELIZA/PARRY-style but domain-obsessed with code. No model calls; indexes a repo on request (tmct index) or reads any producer's graph.",
  "keywords": [
    "chatbot",
    "no-llm",
    "offline",
    "deterministic",
    "eliza",
    "parry",
    "nlp",
    "wink-nlp",
    "owl",
    "rdf",
    "ontology",
    "controlled-natural-language",
    "ace",
    "knowledge-graph",
    "provenance",
    "code-navigation",
    "cli"
  ],
  "license": "MPL-2.0",
  "author": "Polycode Limited",
  "homepage": "https://tmct.polycode.co.uk/",
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/polycode-projects/the-mechanical-code-talker.git"
  },
  "bugs": {
    "url": "https://gitlab.com/polycode-projects/the-mechanical-code-talker/-/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "tmct": "./bin/tmct.mjs"
  },
  "main": "./src/services/index.mjs",
  "exports": {
    ".": "./src/services/index.mjs",
    "./plan": "./src/domain/router/drive.mjs",
    "./generateCompletion": "./src/services/completions.mjs",
    "./createCompletionsGraphAdapter": "./src/services/completions.mjs",
    "./ingest": "./src/services/extract-facts.mjs",
    "./digest": "./src/adapters/corpus/digest-bank.mjs",
    "./memory": "./src/adapters/memory/core.mjs",
    "./repository-interface": "./src/adapters/repository-interface.mjs",
    "./conformance": "./src/tools/conformance.mjs",
    "./ask-browser": "./src/surfaces/web/graph-ask-browser-entry.mjs",
    "./news": "./src/services/news-exports.mjs",
    "./phrase": "./src/domain/phrase-exports.mjs",
    "./envelope": "./test-benchmarks/agentbench/envelope-reader.mjs",
    "./memory-backend-conformance": "./src/tools/memory-backend-conformance.mjs",
    "./memory-backends": "./src/adapters/memory/backends-exports.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "!src/adapters/pii-scan.mjs",
    "!src/domain/corpus-matrix.mjs",
    "!src/domain/licences.mjs",
    "!src/domain/markdown-links.mjs",
    "!src/domain/pack-manifest.mjs",
    "!src/domain/persona/codegen.mjs",
    "!src/domain/pii-rules.mjs",
    "!src/domain/publish-gate.mjs",
    "!src/domain/schemaorg/turtle.mjs",
    "!src/domain/version-stamp.mjs",
    "README.md",
    "LICENSE",
    "corpus/",
    "!corpus/wordnet/generate.mjs",
    "!corpus/namenet/generate.mjs",
    "data/",
    "!data/sprites-large/",
    "test-benchmarks/agentbench/envelope.json",
    "test-benchmarks/agentbench/envelope-reader.mjs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "ink": "^7.1.0",
    "react": "^19.2.7",
    "smol-toml": "^1.7.0",
    "typescript": "~5.6.2",
    "wink-eng-lite-web-model": "^1.8.1",
    "wink-nlp": "^2.4.0"
  },
  "peerDependencies": {
    "@aws-sdk/client-lambda": ">=3",
    "@aws-sdk/lib-dynamodb": ">=3"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-lambda": {
      "optional": true
    },
    "@aws-sdk/lib-dynamodb": {
      "optional": true
    }
  },
  "scripts": {
    "help": "node --disable-warning=ExperimentalWarning bin/tmct.mjs --help",
    "test": "node scripts/ensure-worlds-pack.mjs && node scripts/ensure-sprite-facts.mjs && node --disable-warning=ExperimentalWarning --test --test-concurrency=8 \"test/**/*.test.mjs\"",
    "test:smoke": "node --disable-warning=ExperimentalWarning --test test/smoke/*.test.mjs",
    "test:fast": "node scripts/ensure-worlds-pack.mjs && node --disable-warning=ExperimentalWarning --test --test-concurrency=8 test/smoke/*.test.mjs test/fast/*.test.mjs test/tools/ask.test.mjs test/tools/server.test.mjs test/estate/import-layers.test.mjs",
    "test:unit": "node scripts/ensure-worlds-pack.mjs && node scripts/ensure-sprite-facts.mjs && node --disable-warning=ExperimentalWarning --test --test-concurrency=8 $(node scripts/list-unit-test-files.mjs)",
    "test:slow": "node --disable-warning=ExperimentalWarning --test test/bench/synthbench-code.test.mjs test/readme/readme.test.mjs test/corpus/bench-smoke.test.mjs test/corpus/inference.test.mjs",
    "test:e2e": "node --disable-warning=ExperimentalWarning --test \"test-e2e/*.test.mjs\"",
    "test:e2e:heavy": "node --disable-warning=ExperimentalWarning --test \"test-e2e/heavy/*.test.mjs\"",
