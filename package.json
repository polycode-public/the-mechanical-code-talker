{
  "name": "@polycode-projects/the-mechanical-code-talker",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "The Mechanical Code Talker (tmct) — a tolerant, offline, $0 chat surface that guides you toward precision queries about a software repository. ELIZA/PARRY-style but domain-obsessed with code. No model calls; no codebase index of its own.",
  "license": "MPL-2.0",
  "author": "Polycode Limited",
  "homepage": "https://polycode-projects.gitlab.io/the-mechanical-code-talker/",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "tmct": "./bin/tmct.mjs"
  },
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./chat": "./src/chat.mjs",
    "./resolveObject": "./src/ask.mjs",
    "./ask": "./src/ask.mjs",
    "./relationKind": "./src/codegraph.mjs",
    "./impactClosure": "./src/codegraph.mjs",
    "./dispatchTool": "./src/server.mjs",
    "./fetchEntities": "./src/source.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "ROADMAP.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "smol-toml": "^1.7.0",
    "wink-eng-lite-web-model": "^1.8.1",
    "wink-nlp": "^2.4.0"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\"",
    "chat": "node bin/tmct.mjs"
  }
}
