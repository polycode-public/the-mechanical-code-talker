    "build:row-service": "esbuild server/row-service/handler.mjs --bundle --platform=node --target=node20 --external:@aws-sdk/lib-dynamodb --external:@aws-sdk/client-dynamodb --external:@aws-sdk/client-lambda --outfile=server/row-service/dist/handler.js",
    "build:turn-service": "esbuild server/turn-service/handler.mjs --bundle --platform=node --target=node20 --external:@aws-sdk/lib-dynamodb --external:@aws-sdk/client-dynamodb --external:@aws-sdk/client-lambda --outfile=server/turn-service/dist/handler.js",
    "build:turn-seed": "node server/turn-service/build-seed.mjs",
    "build:news-worker": "esbuild server/news-worker/handler.mjs --bundle --platform=node --target=node20 --external:@aws-sdk/lib-dynamodb --external:@aws-sdk/client-dynamodb --external:@aws-sdk/client-lambda --outfile=server/news-worker/dist/handler.js",
    "build:chat-bundle": "node scripts/build-chat-bundle.mjs",
    "build:spider-fly-bundle": "node scripts/build-spider-fly-bundle.mjs",
    "build:plan-bundle": "node scripts/build-plan-bundle.mjs",
    "build:claims-bundle": "node scripts/build-claims-bundle.mjs",
    "build:ledger-bundle": "node scripts/build-ledger-bundle.mjs",
    "build:ingest-bundle": "node scripts/build-ingest-bundle.mjs",
    "build:research-bundle": "node scripts/build-research-bundle.mjs",
    "build:news-bundle": "node scripts/build-news-bundle.mjs",
    "build:mud-bundle": "node scripts/build-mud-bundle.mjs",
    "build:mudiii-bundle": "node scripts/build-mudiii-bundle.mjs",
    "build:sprites-bundle": "node scripts/build-sprites-bundle.mjs",
