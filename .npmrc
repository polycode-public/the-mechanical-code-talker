# Supply-chain hardening. Install scripts are the main worm vector and this
# dependency set needs none: esbuild's binary arrives via optionalDependencies
# on npm >= 10, and ink/react/smol-toml/wink ship pure JS.
ignore-scripts=true
# Exact pins on install; ranges only move through the cooldown routes.
save-exact=true
# npm ci's own registry audit call has no consumer here (semgrep-sast and
# check:licences are the real security/licence gates) -- it's a network round
# trip on every one of the ~20 npm ci calls a pipeline makes, for a report
# nothing reads. fund is the same shape: a notice nobody acts on in CI.
audit=false
fund=false
