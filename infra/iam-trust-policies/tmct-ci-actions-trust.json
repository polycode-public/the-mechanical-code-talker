{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GitLabOIDCAssumeFromTmctRepo",
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::TBD_CI_ACCOUNT_ID:oidc-provider/gitlab.com"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "gitlab.com:aud": "https://gitlab.com"
        },
        "StringLike": {
          "gitlab.com:sub": "project_path:polycode-projects/the-mechanical-code-talker:ref_type:branch:ref:*"
        }
      }
    }
  ]
}
