node_modules/
__pycache__/

# tmct's own graph/session artifacts (machine-local, rebuildable)
.tmct/

# ...except the bundled EXAMPLE graphs, which are meant to be committed so a new
# user can `npm run example:mini` and see tmct work with no setup. Only the
# graph.json ships; any session logs / memory a user's own run writes under these
# dirs stays ignored (rules below).
!examples/**/.tmct/
!examples/**/.tmct/graph.json
examples/**/.tmct/session-*.log
examples/**/.tmct/session-*.md
examples/**/.tmct/memory/
examples/**/.tmct/sessions/
graph.html
**/.DS_Store

# ...and the large-scale test fixture's own pre-built graph (test/adapters/ask-resolve-ranking.test.mjs
# et al load it directly, same reasoning as the examples above — a realistic multi-file graph
# that reproduces the disambiguation-ranking bug at scale, built once via seonix's indexer +
# ingestSchemaDocs, not regenerated per test run).
!test/fixtures/large-scale/.tmct/
!test/fixtures/large-scale/.tmct/graph.json
test/fixtures/large-scale/.tmct/session-*.log
test/fixtures/large-scale/.tmct/session-*.md
test/fixtures/large-scale/.tmct/memory/
test/fixtures/large-scale/.tmct/sessions/

# the corpus lanes' repo-shaped twin of entities.fixture.json (same entities,
# written the way a real graph producer writes them — ingestSchemaDocs applied
# — so a corpus row's setup.fixture can point a whole session at it).
!test/fixtures/entities-repo/.tmct/
!test/fixtures/entities-repo/.tmct/graph.json
test/fixtures/entities-repo/.tmct/session-*.log
test/fixtures/entities-repo/.tmct/session-*.md
test/fixtures/entities-repo/.tmct/memory/
test/fixtures/entities-repo/.tmct/sessions/

# Claude Code's transient agent worktrees (git-internal checkouts, never committed)
.claude/worktrees/

# local lcov output from coverage runs
.coverage/

# npm
*.log
npm-debug.log*
.env

# a `tmct init` run in this dev repo writes tmct.toml — not tracked here
tmct.toml

# ...except the corpus-lane fixture repos: each is a committed directory whose
# tmct.toml points graph_file at a committed fixture graph (rows drive these
# ephemerally, so nothing else is ever written under them).
!test/fixtures/repos/**/tmct.toml

# scripts/extract-persona-sources.mjs's own output — a maintainer curation
# WORKSHEET (candidates for hand-review), regenerated on demand from the two
# locally-cloned reference repos, never the final committed content itself
# (that's corpus/tier2/human.jsonl + src/grammar/lexicon-core.json, hand-picked
# FROM this worksheet).
scripts/persona-worksheet.json
scripts/persona-examples-candidates.json

# public/engine/ and public/demo-graph.json are CI-GENERATED (see .gitlab-ci.yml's
# `pages` job): literal copies of src/*.mjs + a regenerated demo graph, so src/ stays
# the single source of truth and the published site can never silently drift from it.
# Never commit them — `npm run demo:build` regenerates both locally for testing.
public/engine/
public/demo-graph.json
public/demo-memory.json
public/ledger.html
public/plan.html
public/spider-fly.html
public/adventure.html
public/chat.html
public/sprites.html
public/code.html
public/ingest.html
public/chat-browser.bundle.js
public/spider-fly-browser.bundle.js
public/adventure-browser.bundle.js
public/plan-browser.bundle.js
public/ledger-browser.bundle.js
public/sprites-browser.bundle.js
public/ingest-browser.bundle.js
public/code-explorer.bundle.js
public/chat-seed.json
public/reference-pack/
public/viz-ticker.mjs
public/sprites-pack/
public/vendor/
public/tmct-sw.js
public/*.gz
public/*.br

# Chromium for the browser e2e tier. CI puts it here (PLAYWRIGHT_BROWSERS_PATH)
# so the job cache can carry it between runs; `npm run e2e:browsers` fetches it.
.playwright-browsers/

# electron/renderer/ is BUILT fresh by scripts/build-electron-app.mjs (the demo
# graph rendered to HTML + the dock bundle + the wink vendor asset) and never
# committed — the electron/ shell (main + preload) is the only committed part.
electron/renderer/

# e2e/pages-screenshot-sweep.test.mjs's own output — a layout-review aid for
# a human/agent to look at, regenerated fresh on every run, never a golden
# image compared pixel-to-pixel and never committed.
.screenshots/
