# ontology/tmct-core.ttl — tmct's core OWL 2 ontology (ROADMAP Phase 2, item 3).
#
# Grounds the vocabulary tmct's runtime actually writes:
#   1. the conversational-memory vocabulary of src/memory/core.mjs
#      (Utterance / Fact / Session classes; the mgx: predicates its
#      graph.json payload emits);
#   2. the OWL/RDF(S) kinds the ACE-OWL grammar (src/grammar/ace.mjs)
#      labels its triples with;
#   3. the top-level software-entity classes and core verb properties of
#      the declared lexicon (src/grammar/lexicon-core.json), aligned to
#      the code-graph classes and prop tokens of src/graph-build.mjs.
#
# The runtime stores OWL-LABELLED TRIPLES IN PLAIN JSON (.tmct/, see
# docs/references/schemas/owl2-vocabulary.md) — this document gives those
# labels their formal home; no OWL toolchain runs in the product path.
#
# Prefix provenance:
#   mgx:  urn:tmct:mgx#  — tmct's OWNED extension namespace, exactly the
#         prefix block src/memory/core.mjs's emptyMemory() declares.
#   tmct: urn:tmct:core# — terms minted by the grammar/lexicon (classes,
#         verb predicates). Note: memory/core.mjs's normFactTerm strips
#         CURIE prefixes on fact subjects/objects at write time, so the
#         stored spelling of tmct:module is "module"; this file is the
#         type system those bare terms refer back to.
#   mgxneg: urn:tmct:mgxneg# — tmct's OWNED negative-polarity namespace, the
#         second prefix emptyMemory() declares. GENERATIVE, not enumerable:
#         mgxneg:X is the negative twin of mgx:X for any X, minted on demand
#         by capability.mjs's negatedPredicate. See section 1b.
#   cap:  urn:tmct:cap# — the capability/operator vocabulary (router/registry.mjs).
#         Each tmct tool is a STRIPS/PDDL operator declared as DATA. GENERATIVE:
#         a cap:<name> Capability is minted per tool. Internal — reaches no
#         store. See section 1c.
#   taught: urn:tmct:taught# — taught-action operators and their world-state
#         predicates (router/taught.mjs), layered on cap:. GENERATIVE:
#         taught:<name> per taught game action. Internal — reaches no store.
#         See section 1c.
#   dact: urn:tmct:dact# — the dialogue-act vocabulary (src/domain/
#         dialogue-acts.mjs). The names are ISO 24617-2:2020's own camelCase
#         communicative-function data categories; the namespace is tmct's,
#         because the published standard is paywalled and defines no
#         dereferenceable term IRIs to borrow. See section 1d and
#         docs/references/schemas/iso-24617-2-dialogue-acts.md.
#   seon: SEON, the Software Evolution ONtologies (se-on.org, FAMIX-
#         derived) — the reference vocabulary the code graph's seon:*
#         prop tokens (seon:hasSuperType, seon:containsCodeEntity, …)
#         borrow from. VERIFIED 2026-07-17 against the live code.owl; the
#         term list and the http-only fetch quirk are recorded in
#         docs/references/schemas/seon-code-ontology.md.
#   prov: W3C PROV-O, Recommendation 30 April 2013 — the published
#         provenance vocabulary tmct's source-link family aligns to.
#         docs/references/schemas/prov-o.md.
#   skos: W3C SKOS, Recommendation 18 August 2009.
#         docs/references/schemas/skos.md.
#   cn:   ConceptNet's relation namespace — the origin of the corpus's
#         mirrored mgx: relation names (cited, never claimed as equivalent:
#         a /r/ URI is not an OWL property).
#         docs/references/schemas/conceptnet-relations.md.
#
# Alignment style: a triple that pins tmct's vocabulary to an outside one is
# ADDITIVE — rdfs:subPropertyOf where the entailment is unconditionally true,
# rdfs:seeAlso where it holds only under a restriction this file cannot state.
# No coined term is renamed to match a standard: a rename would break the
# .tmct/graph.json payloads already on disk. See PLAN_NORMATIVE.md.

@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix tmct: <urn:tmct:core#> .
@prefix mgx:  <urn:tmct:mgx#> .
@prefix mgxneg: <urn:tmct:mgxneg#> .
@prefix cap:  <urn:tmct:cap#> .
@prefix taught: <urn:tmct:taught#> .
@prefix dact: <urn:tmct:dact#> .
@prefix seon: <http://se-on.org/ontologies/domain-specific/2012/02/code.owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix cn:   <http://conceptnet.io/r/> .

<urn:tmct:core> a owl:Ontology ;
  rdfs:label "tmct core ontology" ;
  rdfs:comment "The type system behind tmct's conversational memory graph and ACE-OWL grammar emissions. Authored by hand; kept small and aligned with what the code actually writes." .

# ---------------------------------------------------------------------------
# 1. Conversational memory (src/memory/core.mjs) — the classes counted in the
#    memory payload's classes[] and the mgx: vocabulary it documents in-payload.
#    Individuals carry rdf:type owl:NamedIndividual (utterances, sessions) or
#    rdf:type rdf:Statement (reified facts).
# ---------------------------------------------------------------------------

tmct:Utterance a owl:Class ;
  rdfs:label "Utterance" ;
  rdfs:subClassOf prov:Entity ;
  rdfs:comment "One thing said in a chat turn: an a-visitor-said item (role=visitor) or the tmct response alongside it (role=tmct). A prov:Entity: a fixed digital thing, generated by the Session that carries it." .

tmct:Fact a owl:Class ;
  rdfs:label "Fact" ;
  rdfs:subClassOf rdf:Statement ;
  rdfs:subClassOf prov:Entity ;
  rdfs:comment "A grammar-derived OWL triple, RDF-reified: the individual carries rdf:subject / rdf:predicate / rdf:object attribute triples plus mgx:factProvenance. Written only by appendFact (the ACE parser's write point). A prov:Entity, which is what makes mgx:canonicalisedFrom a genuine prov:wasDerivedFrom." .

tmct:Session a owl:Class ;
  rdfs:label "Session" ;
  rdfs:subClassOf prov:Activity ;
  rdfs:comment "One recorded tmct chat session — the anchor utterances attach to via mgx:saidInSession. A prov:Activity: it occurs over a period of time and generates the Utterances in it, which is why mgx:sessionStarted reads as prov:startedAtTime and mgx:saidInSession as prov:wasGeneratedBy." .

tmct:Source a owl:Class ;
  rdfs:label "Source" ;
  rdfs:comment "A first-class provenance individual (rdf:type owl:NamedIndividual) a Fact is derived from, over a closed kind set with deterministic ids: src:operator-chat, src:provider:<name>, src:corpus:<name>, src:learned:web:<urlhash>, src:entailed:<rule>. Carries mgx:sourceType (the trust-prior key), mgx:createdAt, and kind specifics (mgx:sourceUrl / mgx:sourceRule). Not itself subclassed to a prov: class: mgx:sourceType ranges over kinds that fall into all three of PROV's disjoint top classes — operator/teach/provider are prov:Agent, corpus/corpusWeak/web/extracted are prov:Entity, entailed is the trace of a prov:Activity. Naming any single prov: parent on THIS class would assert something false of the other kinds. The split lives in the three read-side subclasses below (tmct:AgentSource / tmct:DocumentSource / tmct:ActivitySource), each under one prov: top class and each keyed to a set of mgx:sourceType values. The classification is DERIVABLE from the sourceType already stored on every Source, so it needs no migration — core.mjs's provSourceClassFor is the read-side classifier." .

# --- The Source split (read-side PROV subclasses) ----------------------------
# tmct:Source is one flat class whose mgx:sourceType key ranges over kinds in
# all three of PROV's disjoint top classes. These three subclasses recover the
# split without touching stored shape: a loaded Source is classified by its
# mgx:sourceType — the same string already on disk — into exactly one. Each is
# defined (owl:equivalentClass) as tmct:Source restricted to its sourceType
# values, and asserted under one prov: top class. This is what lets mgx:statedBy
# carry a real prov:wasAttributedTo for the agent case, where the property-level
# triple can only seeAlso (statedBy still ranges over all three kinds).

tmct:AgentSource a owl:Class ;
  rdfs:label "AgentSource" ;
  rdfs:subClassOf tmct:Source ;
  rdfs:subClassOf prov:Agent ;
  owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
      tmct:Source
      [ a owl:Restriction ;
        owl:onProperty mgx:sourceType ;
        owl:someValuesFrom [ a rdfs:Datatype ; owl:oneOf ( "operator" "teach" "provider" ) ] ]
    )
  ] ;
  rdfs:comment "A Source that ASSERTS a Fact as an actor: mgx:sourceType operator | teach | provider. A prov:Agent — operator and teach are people at the chat, provider is an answer-providing service (a prov:SoftwareAgent). Because this is a prov:Agent, an mgx:statedBy edge whose object is one of these IS prov:wasAttributedTo, the alignment the property-level triple cannot assert." .

tmct:DocumentSource a owl:Class ;
  rdfs:label "DocumentSource" ;
  rdfs:subClassOf tmct:Source ;
  rdfs:subClassOf prov:Entity ;
  owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
      tmct:Source
      [ a owl:Restriction ;
        owl:onProperty mgx:sourceType ;
        owl:someValuesFrom [ a rdfs:Datatype ; owl:oneOf ( "corpus" "corpusWeak" "web" "extracted" "reference" "referenceLive" "optimisticExtract" ) ] ]
    )
  ] ;
  rdfs:comment "A Source that IS a fixed document a Fact was read from: mgx:sourceType corpus | corpusWeak | web | extracted | reference | referenceLive. A prov:Entity. An mgx:statedBy edge to one of these is nearer prov:hadPrimarySource than attribution — a document is cited, not credited as an agent. A reference source names a shipped reference-pack article; referenceLive names a live-fetched Wikipedia article, scored below the curated pack; optimisticExtract names the fuzzy tier's candidate facts, scored below every curated pack." .

tmct:ActivitySource a owl:Class ;
  rdfs:label "ActivitySource" ;
  rdfs:subClassOf tmct:Source ;
  rdfs:subClassOf prov:Activity ;
  owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
      tmct:Source
      [ a owl:Restriction ;
        owl:onProperty mgx:sourceType ;
        owl:someValuesFrom [ a rdfs:Datatype ; owl:oneOf ( "entailed" ) ] ]
    )
  ] ;
  rdfs:comment "A Source that IS the trace of a rule firing: mgx:sourceType entailed. A prov:Activity. An mgx:statedBy edge to one of these reads as prov:wasGeneratedBy — the Fact was produced by the inference run named in mgx:sourceRule." .

mgx:saidInSession a owl:ObjectProperty ;
  rdfs:label "saidInSession" ;
  rdfs:domain tmct:Utterance ;
  rdfs:range tmct:Session ;
  rdfs:subPropertyOf prov:wasGeneratedBy ;
  rdfs:comment "Utterance to the Session it was said in; runtime observation, owned (no SEON term). This IS prov:wasGeneratedBy: the domain is a prov:Entity and the range a prov:Activity, which is exactly that property's signature." .

mgx:inReplyTo a owl:ObjectProperty ;
  rdfs:label "inReplyTo" ;
  rdfs:domain tmct:Utterance ;
  rdfs:range tmct:Utterance ;
  rdfs:comment "tmct Utterance to the visitor Utterance it answers (the Q/A pairing)." .

mgx:utteranceRole a owl:DatatypeProperty ;
  rdfs:domain tmct:Utterance ;
  rdfs:range xsd:string ;
  rdfs:comment "Who said it: visitor or tmct." .

mgx:utteranceText a owl:DatatypeProperty ;
  rdfs:domain tmct:Utterance ;
  rdfs:range xsd:string ;
  rdfs:comment "The utterance's normalized text (capped)." .

mgx:utteranceTs a owl:DatatypeProperty ;
  rdfs:domain tmct:Utterance ;
  rdfs:range xsd:dateTime ;
  rdfs:comment "When it was said, ISO-8601 (the chat turn timestamp)." .

mgx:utteranceParsed a owl:DatatypeProperty ;
  rdfs:domain tmct:Utterance ;
  rdfs:range xsd:string ;
  rdfs:comment "Optional JSON of the interpretation pipeline's parse of this request." .

mgx:sessionStarted a owl:DatatypeProperty ;
  rdfs:domain tmct:Session ;
  rdfs:range xsd:dateTime ;
  rdfs:subPropertyOf prov:startedAtTime ;
  rdfs:comment "Session anchor: when the session started, ISO-8601. This IS prov:startedAtTime: domain prov:Activity, range xsd:dateTime, same meaning. tmct has no prov:endedAtTime twin — a session is never marked finished." .

mgx:factProvenance a owl:DatatypeProperty ;
  rdfs:domain tmct:Fact ;
  rdfs:range xsd:string ;
  owl:deprecated true ;
  rdfs:comment "LEGACY COMPAT SHIM. The ace:<source>[:<sessionId>][@<ts>] / corpus:<name> provenance tags a fact came from, union-joined by ' | '. The source-of-truth is now the mgx:statedBy edges DERIVED from this string; kept byte-identical for readers still keying on it." .

mgx:factQuantifier a owl:DatatypeProperty ;
  rdfs:domain tmct:Fact ;
  rdfs:range xsd:string ;
  rdfs:comment "OPTIONAL: the quantifier word a plural class-membership teach used ('every'/'some'/'a few'), for literal recall by 'how many Xs are Ys'. Never real cardinality counting — the counted forms are owl:minCardinality / owl:maxCardinality / owl:cardinality (pattern 5)." .

mgx:factJustification a owl:DatatypeProperty ;
  rdfs:domain tmct:Fact ;
  rdfs:range xsd:string ;
  rdfs:seeAlso prov:wasDerivedFrom ;
  rdfs:comment "The space-joined premise Fact ids an entailed Fact was derived from (syllogise.mjs's forward-chaining pass; last-write-wins). With mgx:sourceRule on the entailed Source, the pair is an ATMS justification in de Kleer's sense — antecedents + consequent + informant, where the rule id is the informant (de Kleer 1986 §4.2). NOT a JTMS justification: Doyle's SL-justification carries an inlist AND an outlist, and it is the outlist that makes a justification an assumption and gives the system non-monotonicity. This property has no outlist, so every justification it records is a monotonic Horn-style deduction. What de Kleer calls a label — what a datum ultimately depends on — tmct does not compute." .

# --- Taught rules (the query-dispatcher's lookup keys) -----------------------
# The rule kinds are a CLOSED structural vocabulary (compose2 | filter |
# recursive, plus the action-* family), tagged like 'Fact' and 'Rule'
# themselves and never a domain word. The action-rule shape
# (signature/precondition/effect) is STRIPS's and PDDL's — see
# docs/references/planning/STRIPS_PDDL.md — but tmct does not use PDDL's own
# names for them. The router's cap:/taught: vocabulary carries that alignment;
# it is declared in section 1c.

mgx:ruleName a owl:DatatypeProperty ;
  rdfs:range xsd:string ;
  rdfs:comment "A taught Rule's own name (e.g. 'grandparent') — the query-dispatcher's lookup key." .

mgx:ruleKind a owl:DatatypeProperty ;
  rdfs:range xsd:string ;
  rdfs:comment "A taught Rule's SHAPE tag, over the closed vocabulary compose2 | filter | recursive (structural, like 'Fact'/'Rule' themselves, never a domain word). shacl.mjs enforces the closed set." .

mgx:ruleBase1 a owl:DatatypeProperty ;
  rdfs:range xsd:string ;
  rdfs:comment "compose2: the first hop's base relation name. filter: the base rule/relation being filtered — the same 'base relation' role in both kinds, so the name is shared." .

mgx:ruleBase2 a owl:DatatypeProperty ;
  rdfs:range xsd:string ;
  rdfs:comment "compose2 only: the second hop's base relation name." .

mgx:ruleFilterProperty a owl:DatatypeProperty ;
  rdfs:range xsd:string ;
  rdfs:comment "filter only: the property literal candidates are filtered by (an mgx:hasProperty-shaped Fact lookup)." .

mgx:ruleBaseCase a owl:DatatypeProperty ;
  rdfs:range xsd:string ;
  rdfs:comment "recursive only: the base-case relation name (hop zero)." .

mgx:ruleRecStep a owl:DatatypeProperty ;
  rdfs:range xsd:string ;
  rdfs:comment "recursive only: the self-referential recursive-step relation name." .

# --- Provenance & Trust (PLAN_PROVENANCE_TRUST) — the one source-link primitive ---

mgx:createdAt a owl:DatatypeProperty ;
  rdfs:range xsd:dateTime ;
  rdfs:seeAlso prov:generatedAtTime ;
  rdfs:comment "When an individual was FIRST written, ISO-8601 (first-write-wins on upsert). Carried by every created individual (Utterance / Fact / Session / Source / block-index entry). Distinct from mgx:utteranceTs (the turn time an utterance CLAIMS). The audit 'when', the recency input to trust, and Phase 9's novelty signal. seeAlso rather than equivalentProperty prov:generatedAtTime: that property's domain is prov:Entity, and this one is also carried by Sessions, which are prov:Activity — where the PROV term is startedAtTime." .

mgx:updatedAt a owl:DatatypeProperty ;
  rdfs:range xsd:dateTime ;
  rdfs:comment "When an individual's OWN attributes were last mutated in place (upsertSession, recomputeFactTrust, recomputeSourceReliability); most individuals never carry it. No PROV referent, and the absence is structural rather than an oversight: a prov:Entity does not change, so PROV models an update as a NEW entity standing in prov:wasRevisionOf to the old one. tmct mutates in place and keeps one id. Aligning would mean versioning every individual." .

mgx:derivedFrom a owl:ObjectProperty ;
  rdfs:label "derivedFrom" ;
  rdfs:domain tmct:Fact ;
  rdfs:range tmct:Source ;
  rdfs:subPropertyOf prov:wasInfluencedBy ;
  rdfs:comment "Umbrella: a Fact derived from a Source (or another Fact). Its PROV referent is prov:wasInfluencedBy, NOT prov:wasDerivedFrom: this property unions attribution (a source ASSERTED the fact) with derivation (a fact was CLEANED from another), and PROV keeps those apart as wasAttributedTo and wasDerivedFrom. wasInfluencedBy is the umbrella over both, so the subPropertyOf above is unconditionally true. VERIFIED 2026-07-17 against PROV-O (W3C Rec 2013-04-30)." .

mgx:statedBy a owl:ObjectProperty ;
  rdfs:label "statedBy" ;
  rdfs:subPropertyOf mgx:derivedFrom ;
  rdfs:domain tmct:Fact ;
  rdfs:range tmct:Source ;
  rdfs:seeAlso prov:wasAttributedTo ;
  rdfs:comment "The workhorse: a Source directly ASSERTS this Fact. The old mgx:factProvenance ' | '-union becomes N statedBy edges, one per independent Source — the corroboration signal a ranker can read. The property-level triple stays seeAlso, not subPropertyOf prov:wasAttributedTo: statedBy ranges over tmct:Source, which unions PROV's three disjoint top classes (operator/teach/provider Agent, corpus/corpusWeak/web/extracted Entity, entailed Activity), so subPropertyOf would over-claim the Agent range for the document and activity kinds. The real alignment now lives at the SUBCLASS level: a statedBy edge whose object is a tmct:AgentSource lands on a prov:Agent and IS prov:wasAttributedTo; to a tmct:DocumentSource it is nearer prov:hadPrimarySource, and to a tmct:ActivitySource, prov:wasGeneratedBy." .

mgx:canonicalisedFrom a owl:ObjectProperty ;
  rdfs:label "canonicalisedFrom" ;
  rdfs:subPropertyOf mgx:derivedFrom ;
  rdfs:subPropertyOf prov:wasDerivedFrom ;
  rdfs:comment "A canonical Fact derived by cleaning from a raw form (Phase 7 canonicalise-and-link; tier-4 raw→cleaned). Points at the raw Block/Source, never replacing it. This IS prov:wasDerivedFrom: both ends are prov:Entity (a Fact cleaned from an Utterance), which is the case mgx:derivedFrom's umbrella cannot assume. PROV's wasRevisionOf is the closer fit in spirit but asserts the result REPLACES the original, which canonicalisation explicitly does not." .

mgx:sourceType a owl:DatatypeProperty ;
  rdfs:domain tmct:Source ;
  rdfs:range xsd:string ;
  rdfs:comment "A Source's kind: operator | provider | corpus | web | entailed — the trust-prior key." .

mgx:sourceUrl a owl:DatatypeProperty ;
  rdfs:domain tmct:Source ;
  rdfs:range xsd:string ;
  rdfs:comment "A web Source's URL (the src:learned:web:<urlhash> specific)." .

mgx:sourceRule a owl:DatatypeProperty ;
  rdfs:domain tmct:Source ;
  rdfs:range xsd:string ;
  rdfs:comment "An entailed Source's rule id (the src:entailed:<rule> specific)." .

# The trust family has no PROV referent. PROV records who said a thing, not
# whether to believe them — there is no trust or reliability term anywhere in
# the Recommendation. No W3C Recommendation covers it. Candidate literatures
# for a session that wants to ground this: Golbeck on trust propagation in
# social/semantic networks; Artz & Gil, "A survey of trust in computer science
# and the Semantic Web" (J. Web Semantics 5(2), 2007); the W3C Provenance
# Incubator Group's trust use cases. Until one is picked, these stay mgx:.

mgx:trustScore a owl:DatatypeProperty ;
  rdfs:domain tmct:Fact ;
  rdfs:range xsd:decimal ;
  rdfs:comment "Materialised trust cache in [0,1] — a PURE function of a fact's Sources + createdAt (src/memory/trust.mjs: source-type prior, noisy-OR corroboration, bounded recency nudge). Never hand-set; invalidated when a statedBy edge is added." .

mgx:sourceReliability a owl:DatatypeProperty ;
  rdfs:domain tmct:Source ;
  rdfs:range xsd:decimal ;
  rdfs:comment "Actor-level (session-scoped) trust nudge in [0.5,1.5], neutral 1.0 when absent — materialised by recomputeSourceReliability from a session's asserted-vs-contradicted track record (memory/trust.mjs's sessionReliabilityFrom); folds into computeTrust's per-source prior." .

mgx:trustInputs a owl:DatatypeProperty ;
  rdfs:domain tmct:Fact ;
  rdfs:range xsd:string ;
  rdfs:comment "JSON of the inputs mgx:trustScore was computed from (source-type multiset, corroboration count, createdAt, recency multiplier) — so any score is reproducible and auditable." .

mgx:hasProseTokens a owl:DatatypeProperty ;
  rdfs:range xsd:string ;
  rdfs:comment "Prose tokens (prose.mjs tokenizer) backing the payload's proseIndex; carried by any memory individual with indexable text." .

# ---------------------------------------------------------------------------
# 1b. Negative polarity (urn:tmct:mgxneg#) — the second namespace every graph
#     tmct writes declares, and the one this file used to omit.
#
#     mgxneg: is GENERATIVE. capability.mjs's negatedPredicate swaps the prefix
#     on any mgx:X to mint mgxneg:X, so the namespace holds exactly as many
#     terms as mgx: does and cannot be enumerated here. What this section
#     declares is the CONVENTION; individual twins below are only the two the
#     code names explicitly.
#
#     Why polarity rides on the predicate and not a separate property: a Fact
#     is content-addressed by (subject, predicate, object). A polarity flag as
#     its own attribute would leave both polarities sharing one id, so
#     "a penguin can fly" and "a penguin cannot fly" would union their
#     statedBy edges into one fact that asserts and denies itself.
#
#     Why not owl:disjointWith or owl:negativePropertyAssertion: disjointness
#     is a class-class axiom ("no man is a stone"). "john is not a man" denies
#     ONE membership and says nothing about any other john, so disjointness
#     would over-claim. OWL 2's negativePropertyAssertion says the right thing,
#     but it is a reified axiom shape the flat JSON store has no room for —
#     the same constraint that flattens pattern-4 intersections above.
# ---------------------------------------------------------------------------

mgxneg:capableOf a owl:ObjectProperty ;
  rdfs:label "capableOf (negated)" ;
  rdfs:comment "The negative twin of mgx:capableOf: 'a penguin cannot fly'. Minted by the prefix swap, and named here as the worked example of the convention." .

mgxneg:subClassOf a owl:ObjectProperty ;
  rdfs:label "subClassOf (negated)" ;
  rdfs:comment "The negative twin of rdfs:subClassOf: 'john is not a man'. ASYMMETRIC, and the reason this namespace needs a stated member at all: the polarity prefix is tmct's and the term negated is RDFS's, so the prefix swap cannot mint it and capability.mjs states it in EXPLICIT_NEGATIVE_TWINS. Reading it back by prefix swap would give 'mgx:subClassOf', which exists nowhere." .

# ---------------------------------------------------------------------------
# 1c. The capability/operator vocabulary (urn:tmct:cap#, urn:tmct:taught#).
#
#     router/registry.mjs models every tmct tool as a classical planning
#     operator declared as DATA: a Capability with typed Parameters, a
#     Precondition list and an Effect list (add/delete). resolver.mjs
#     backward-chains from a goal to a capability whose add-list achieves it.
#     router/taught.mjs bridges a taught game action into the SAME shape, so
#     one planner covers built-in tools and taught actions alike.
#
#     This IS the STRIPS operator model (Fikes & Nilsson, "STRIPS: A New
#     Approach to the Application of Theorem Proving to Problem Solving",
#     Artificial Intelligence 2, 1971) and PDDL's action model (McDermott et
#     al., "PDDL — The Planning Domain Definition Language", 1998).
#     cap:Precondition and cap:Effect are PDDL's :precondition and :effect
#     under tmct's own names. See docs/references/planning/STRIPS_PDDL.md.
#
#     Both namespaces are GENERATIVE and internal — they reach no store, so
#     unlike mgx:/mgxneg: no graph payload declares them. cap:<name> is minted
#     per registered tool and taught:<name> per taught action; enumerating them
#     here would be wrong the first tool or game added. What this section
#     declares is the CONVENTION and the closed structural vocabulary each
#     builds operators from.
# ---------------------------------------------------------------------------

cap:Capability a owl:Class ;
  rdfs:label "Capability" ;
  rdfs:comment "A tool/operator: a named action with typed Parameters, Preconditions and Effects. A STRIPS/PDDL operator declared as data. cap:<name> individuals are minted per registered tool." .

cap:Parameter a owl:Class ;
  rdfs:label "Parameter" ;
  rdfs:comment "A typed operator slot. Its KIND is one of the closed set below (a graph-entity type the resolver must bind, or a free-text/enum slot with no resolution)." .

cap:Precondition a owl:Class ;
  rdfs:label "Precondition" ;
  rdfs:comment "A condition that must hold before the operator fires. PDDL's :precondition under tmct's name. The predicate tag is one of the closed set below." .

cap:Effect a owl:Class ;
  rdfs:label "Effect" ;
  rdfs:comment "A change the operator makes to the world/agent state (add-list / delete-list). PDDL's :effect under tmct's name." .

# Parameter KINDs — the free-text/enum slot types that carry no resolution
# precondition (graph-entity kinds are the code-graph classes above: Module,
# Class, seon:CodeEntity).
cap:FreeText a owl:Class ; rdfs:label "FreeText" ; rdfs:comment "A lexical search-string slot — no graph resolution." .
cap:KindFilter a owl:Class ; rdfs:label "KindFilter" ; rdfs:comment "An enum slot: function|class|method|… search filter." .
cap:PackageName a owl:Class ; rdfs:label "PackageName" ; rdfs:comment "An optional architecture-scope filter slot." .

# Precondition predicate tags (the closed vocabulary a Precondition uses) and
# the Effect predicate. Declared as annotation properties: they tag a shape
# rather than assert an OWL relation over individuals.
cap:graph-loaded a owl:AnnotationProperty ; rdfs:label "graph-loaded" ; rdfs:comment "Precondition: a graph artifact is present and parseable." .
cap:resolves a owl:AnnotationProperty ; rdfs:label "resolves" ; rdfs:comment "Precondition { param, as }: the named slot binds to a graph entity of kind `as`." .
cap:any-present a owl:AnnotationProperty ; rdfs:label "any-present" ; rdfs:comment "Precondition { params }: at least one of the named slots is provided (search-style disjunction)." .
cap:knows a owl:AnnotationProperty ; rdfs:label "knows" ; rdfs:comment "Add-effect: after the call the agent knows `topic` about the bound `of` slot." .

# taught: — a taught action reuses cap:'s Capability/Parameter/Precondition/
# Effect types and adds its own world-state predicate tags. GENERATIVE:
# taught:<name> is the operator per taught game action.
taught:world-precond a owl:AnnotationProperty ; rdfs:label "world-precond" ; rdfs:comment "A taught action's precondition over world state (from an action-precond Rule)." .
taught:world-constraint a owl:AnnotationProperty ; rdfs:label "world-constraint" ; rdfs:comment "A taught action's constraint over world state (from an action-constraint Rule)." .
taught:world-effect a owl:AnnotationProperty ; rdfs:label "world-effect" ; rdfs:comment "A taught action's add-effect on world state (from an action-effect Rule)." .
taught:world-effect-replaced a owl:AnnotationProperty ; rdfs:label "world-effect-replaced" ; rdfs:comment "A taught action's delete/replace-effect: the prior world fact this effect supersedes." .

# ---------------------------------------------------------------------------
# 1d. Dialogue acts (urn:tmct:dact#) — ISO 24617-2 communicative functions.
#
#     src/domain/dialogue-acts.mjs names tmct's turn types to ISO 24617-2:2020
#     (SemAF Part 2, dialogue acts): the router already sorts every turn into a
#     lane, and the label is a fixed lookup over that decision — a table, never
#     a classifier. The dact: names below are the standard's own camelCase
#     data-category names; each carries its dimension as a plain string over
#     the standard's ten data categories. The set is CLOSED and mirrored
#     two-ways against the module's DIALOGUE_ACTS table by test.
#
#     The honesty-preserving line: tmct's miss is dact:autoNegative in the
#     autoFeedback dimension — the sender reporting on its OWN processing of
#     the turn — never a task answer.
# ---------------------------------------------------------------------------

dact:CommunicativeFunction a owl:Class ;
  rdfs:label "CommunicativeFunction" ;
  rdfs:comment "An ISO 24617-2 communicative function: what an utterance does in the dialogue (question, inform, request, feedback, greeting). Individuals below are the subset tmct's lanes produce; the standard's remaining functions join as lanes produce them." .

dact:dimension a owl:AnnotationProperty ;
  rdfs:label "dimension" ;
  rdfs:comment "The ISO 24617-2 dimension a function is annotated in, over the ten camelCase data categories: task, autoFeedback, alloFeedback, turnManagement, timeManagement, discourseStructuring, ownCommunicationManagement, partnerCommunicationManagement, socialObligationsManagement, contactManagement." .

dact:propositionalQuestion a dact:CommunicativeFunction ;
  rdfs:label "propositionalQuestion" ;
  dact:dimension "task" ;
  rdfs:comment "A yes/no question about whether a proposition holds ('does X import Y?')." .

dact:checkQuestion a dact:CommunicativeFunction ;
  rdfs:label "checkQuestion" ;
  dact:dimension "task" ;
  rdfs:comment "A yes/no question whose asker already expects the answer yes ('..., right?')." .

dact:setQuestion a dact:CommunicativeFunction ;
  rdfs:label "setQuestion" ;
  dact:dimension "task" ;
  rdfs:comment "A wh-question asking for the members of a set ('what does X import?')." .

dact:choiceQuestion a dact:CommunicativeFunction ;
  rdfs:label "choiceQuestion" ;
  dact:dimension "task" ;
  rdfs:comment "A question asking which of the listed alternatives holds ('is X a module or a class?')." .

dact:inform a dact:CommunicativeFunction ;
  rdfs:label "inform" ;
  dact:dimension "task" ;
  rdfs:comment "A declarative telling the addressee something (a teach turn; also tmct explaining its own function)." .

dact:answer a dact:CommunicativeFunction ;
  rdfs:label "answer" ;
  dact:dimension "task" ;
  rdfs:comment "An inform that discharges a question just asked (an answer grounded in the graph)." .

dact:confirm a dact:CommunicativeFunction ;
  rdfs:label "confirm" ;
  dact:dimension "task" ;
  rdfs:comment "An answer 'yes' to a check question." .

dact:disconfirm a dact:CommunicativeFunction ;
  rdfs:label "disconfirm" ;
  dact:dimension "task" ;
  rdfs:comment "An answer 'no' to a check question." .

dact:agreement a dact:CommunicativeFunction ;
  rdfs:label "agreement" ;
  dact:dimension "task" ;
  rdfs:comment "An inform stating that the speaker holds what the addressee just stated to be true." .

dact:disagreement a dact:CommunicativeFunction ;
  rdfs:label "disagreement" ;
  dact:dimension "task" ;
  rdfs:comment "An inform stating that the speaker holds what the addressee just stated to be false." .

dact:correction a dact:CommunicativeFunction ;
  rdfs:label "correction" ;
  dact:dimension "task" ;
  rdfs:comment "A disagreement that also supplies the replacement ('no, I meant Y')." .

dact:request a dact:CommunicativeFunction ;
  rdfs:label "request" ;
  dact:dimension "task" ;
  rdfs:comment "Asks the addressee to perform an action ('solve it' — a goal turn)." .

dact:instruct a dact:CommunicativeFunction ;
  rdfs:label "instruct" ;
  dact:dimension "task" ;
  rdfs:comment "A request the addressee is expected to carry out without negotiation (a bare imperative)." .

dact:suggestion a dact:CommunicativeFunction ;
  rdfs:label "suggestion" ;
  dact:dimension "task" ;
  rdfs:comment "Puts an action forward as advisable without claiming authority over the addressee." .

dact:offer a dact:CommunicativeFunction ;
  rdfs:label "offer" ;
  dact:dimension "task" ;
  rdfs:comment "Commits the speaker to an action, conditional on the addressee wanting it." .

dact:autoPositive a dact:CommunicativeFunction ;
  rdfs:label "autoPositive" ;
  dact:dimension "autoFeedback" ;
  rdfs:comment "The sender reports its own processing of the previous turn succeeded (an acknowledgement)." .

dact:autoNegative a dact:CommunicativeFunction ;
  rdfs:label "autoNegative" ;
  dact:dimension "autoFeedback" ;
  rdfs:comment "The sender reports its own processing of the previous turn failed — tmct's honest miss." .

dact:initialGreeting a dact:CommunicativeFunction ;
  rdfs:label "initialGreeting" ;
  dact:dimension "socialObligationsManagement" ;
  rdfs:comment "Opens an exchange of greetings ('hi')." .

dact:returnGreeting a dact:CommunicativeFunction ;
  rdfs:label "returnGreeting" ;
  dact:dimension "socialObligationsManagement" ;
  rdfs:comment "Answers a greeting with a greeting." .

dact:thanking a dact:CommunicativeFunction ;
  rdfs:label "thanking" ;
  dact:dimension "socialObligationsManagement" ;
  rdfs:comment "Expresses gratitude for something the addressee did." .

dact:apology a dact:CommunicativeFunction ;
  rdfs:label "apology" ;
  dact:dimension "socialObligationsManagement" ;
  rdfs:comment "Expresses regret for something the speaker did." .

# ---------------------------------------------------------------------------
# 2. Grammar-emitted kinds (src/grammar/ace.mjs) — how the 8 ACE-OWL patterns
#    use the standard vocabulary. Facts store these as predicate strings; the
#    `kind` label on each emitted triple names the governing OWL construct.
#
#    pattern 1  every N1 is a N2            rdfs:subClassOf
#    pattern 2  PROPERNAME is a N           rdf:type
#    pattern 3  N1 VERB N2                  a tmct: object property (below)
#    pattern 4  every N1 that VERBs a N2    owl:Restriction + owl:onProperty +
#               is a N3                     owl:someValuesFrom, and the N1-
#                                           intersection subclassed to N3
#    pattern 5  every N has at least/at     owl:minCardinality / owl:maxCardinality /
#               most/exactly n N2           owl:cardinality on tmct:has, with
#                                           owl:onClass recording the counted class
#    pattern 6  no N1 is a N2               owl:disjointWith
#    pattern 7  N1's N2 is VALUE            owl:DatatypeProperty or owl:ObjectProperty
#                                           assertion per the noun's declared typing
#    pattern 8  ADJ N / X is ADJ            rdfs:subClassOf (subclass-forming ADJ) or
#                                           owl:hasValue restriction / owl:DatatypeProperty
#                                           assertion (data ADJ)
#
#    Flat-store stand-in: the JSON fact store has no RDF lists, so a pattern-4
#    intersection is flattened to REPEATED owl:intersectionOf triples (one per
#    member) on a readable deterministic node, e.g.
#      tmct:module-that-imports-database owl:intersectionOf tmct:module ;
#                                        owl:intersectionOf tmct:some-imports-database .
#    In proper Turtle that intersection reads:
# ---------------------------------------------------------------------------

tmct:has a owl:ObjectProperty ;
  rdfs:label "has" ;
  rdfs:comment "The generic possession property pattern-5 cardinality restrictions constrain (every module has at least 1 test)." .

# Documentation example of a pattern-4 emission in real Turtle (kept as a
# named, deterministic node exactly as the grammar mints it):
tmct:some-imports-database a owl:Restriction ;
  owl:onProperty tmct:imports ;
  owl:someValuesFrom tmct:database .

tmct:module-that-imports-database a owl:Class ;
  owl:intersectionOf ( tmct:module tmct:some-imports-database ) ;
  rdfs:subClassOf tmct:service .

# ---------------------------------------------------------------------------
# 3. Software-entity classes — the lexicon's top-level nouns (lowercase lemma
#    = the normFactTerm spelling facts store), aligned to the code-graph
#    classes buildEntities emits (Module, Class, Function, Method, Attribute,
#    GlobalVariable, Commit, Session — see src/schema-docs.mjs).
# ---------------------------------------------------------------------------

tmct:module a owl:Class ;
  rdfs:label "module" ;
  rdfs:comment "A source file / importable unit. Aligns with the code-graph class Module." .

tmct:class a owl:Class ;
  rdfs:label "class" ;
  rdfs:comment "A class definition. Aligns with the code-graph class Class; cf. seon:ComplexType." .

tmct:function a owl:Class ;
  rdfs:label "function" ;
  rdfs:comment "A top-level function. Aligns with the code-graph class Function." .

tmct:method a owl:Class ;
  rdfs:label "method" ;
  rdfs:comment "A function inside a class. Aligns with the code-graph class Method; cf. seon:Method." .

tmct:attribute a owl:Class ;
  rdfs:label "attribute" ;
  rdfs:comment "A field/property of a class. Aligns with the code-graph class Attribute; cf. seon:Field (SEON has no Attribute class — VERIFIED 2026-07-17 against code.owl; its instance-variable class is Field, subclassed from Variable)." .

tmct:variable a owl:Class ;
  rdfs:label "variable" ;
  rdfs:comment "A module-level variable. Aligns with the code-graph class GlobalVariable." .

tmct:commit a owl:Class ;
  rdfs:label "commit" ;
  rdfs:comment "A recorded git commit. Aligns with the code-graph class Commit." .

tmct:test a owl:Class ;
  rdfs:label "test" ;
  rdfs:comment "A test (module or case) — the subject side of mgx:testsCoverage edges." .

tmct:repository a owl:Class ; rdfs:label "repository" .
tmct:service a owl:Class ; rdfs:label "service" .
tmct:package a owl:Class ; rdfs:label "package" .
tmct:database a owl:Class ; rdfs:label "database" .
tmct:bug a owl:Class ; rdfs:label "bug" .
tmct:branch a owl:Class ; rdfs:label "branch" .
tmct:developer a owl:Class ; rdfs:label "developer" .
tmct:project a owl:Class ; rdfs:label "project" .

# The one code-graph attribute tmct owns rather than borrows from SEON: the
# flavour of a Class define (interface/enum/struct/record) when it is not a
# plain class. buildEntities emits it on Class individuals; kind stays "class".
mgx:subKind a owl:DatatypeProperty ;
  rdfs:label "subKind" ;
  rdfs:domain tmct:class ;
  rdfs:range xsd:string ;
  rdfs:comment "The flavour of a type declaration when it is not a plain class: interface, enum, struct or record. A tmct extension — SEON's code.owl has no subKind property, so this rides the mgx: namespace rather than seon: (the same reason mgx:touchedByCommit is owned, not seon:history). VERIFIED 2026-07-17 against code.owl." .

# ---------------------------------------------------------------------------
# 4. Core verb properties — the tmct:<3sg> predicates lexicon verbs emit
#    (grammar/lexicon.mjs predicateOf), rdfs:seeAlso-aligned to the code
#    graph's prop tokens where one exists.
# ---------------------------------------------------------------------------

tmct:imports a owl:ObjectProperty ;
  rdfs:label "imports" ;
  rdfs:seeAlso mgx:importsNamespace ;
  rdfs:comment "Subject imports object. The code graph's module-to-module edge is mgx:importsNamespace." .

tmct:calls a owl:ObjectProperty ;
  rdfs:label "calls" ;
  rdfs:seeAlso mgx:callsSymbol ;
  rdfs:comment "Subject calls object; cf. mgx:callsCoarse (module level) and seon:invokesMethod." .

tmct:tests a owl:ObjectProperty ;
  rdfs:label "tests" ;
  rdfs:seeAlso mgx:testsCoverage .

tmct:contains a owl:ObjectProperty ;
  rdfs:label "contains" ;
  rdfs:seeAlso seon:containsCodeEntity .

tmct:extends a owl:ObjectProperty ;
  rdfs:label "extends" ;
  rdfs:seeAlso seon:hasSuperType ;
  rdfs:comment "Subject extends/inherits from object; the code graph's inheritance edge is seon:hasSuperType." .

tmct:defines a owl:ObjectProperty ;
  rdfs:label "defines" ;
  rdfs:seeAlso seon:declaresMethod .

tmct:touches a owl:ObjectProperty ;
  rdfs:label "touches" ;
  rdfs:seeAlso mgx:touchesSymbol ;
  rdfs:comment "A commit touches a module/symbol; cf. mgx:touchedByCommit (inverse orientation in the code graph)." .

tmct:uses a owl:ObjectProperty ; rdfs:label "uses" .
tmct:dependsOn a owl:ObjectProperty ; rdfs:label "dependsOn" .
tmct:reliesOn a owl:ObjectProperty ; rdfs:label "reliesOn" .
tmct:inheritsFrom a owl:ObjectProperty ; rdfs:label "inheritsFrom" ; rdfs:seeAlso seon:hasSuperType .
tmct:implements a owl:ObjectProperty ; rdfs:label "implements" .
tmct:exports a owl:ObjectProperty ; rdfs:label "exports" ; rdfs:seeAlso mgx:reExports .
tmct:covers a owl:ObjectProperty ; rdfs:label "covers" ; rdfs:seeAlso mgx:testsCoverage .

# ---------------------------------------------------------------------------
# 5. Possessive-noun and data-adjective properties (patterns 7 and 8) — the
#    lexicon's declared typings: property=data nouns and type=data adjectives
#    become owl:DatatypeProperty assertions; property=object nouns become
#    owl:ObjectProperty assertions.
# ---------------------------------------------------------------------------

tmct:license a owl:DatatypeProperty ; rdfs:label "license" ; rdfs:range xsd:string .
tmct:version a owl:DatatypeProperty ; rdfs:label "version" ; rdfs:range xsd:string .
tmct:name a owl:DatatypeProperty ; rdfs:label "name" ; rdfs:range xsd:string .
tmct:path a owl:DatatypeProperty ; rdfs:label "path" ; rdfs:range xsd:string .
tmct:size a owl:DatatypeProperty ; rdfs:label "size" ; rdfs:range xsd:string .
tmct:status a owl:DatatypeProperty ; rdfs:label "status" ; rdfs:range xsd:string .
tmct:language a owl:DatatypeProperty ; rdfs:label "language" ; rdfs:range xsd:string .
tmct:extension a owl:DatatypeProperty ; rdfs:label "extension" ; rdfs:range xsd:string .

tmct:owner a owl:ObjectProperty ; rdfs:label "owner" .
tmct:maintainer a owl:ObjectProperty ; rdfs:label "maintainer" .
tmct:author a owl:ObjectProperty ; rdfs:label "author" ; rdfs:seeAlso mgx:commitAuthor .
tmct:reviewer a owl:ObjectProperty ; rdfs:label "reviewer" .
tmct:parent a owl:ObjectProperty ; rdfs:label "parent" .
tmct:dependency a owl:ObjectProperty ; rdfs:label "dependency" .

tmct:deprecated a owl:DatatypeProperty ; rdfs:label "deprecated" ; rdfs:range xsd:boolean .
tmct:flaky a owl:DatatypeProperty ; rdfs:label "flaky" ; rdfs:range xsd:boolean .
tmct:tested a owl:DatatypeProperty ; rdfs:label "tested" ; rdfs:range xsd:boolean .
tmct:documented a owl:DatatypeProperty ; rdfs:label "documented" ; rdfs:range xsd:boolean .
tmct:broken a owl:DatatypeProperty ; rdfs:label "broken" ; rdfs:range xsd:boolean .

# Subclass-forming adjectives denote classes (pattern 8): legacy-module is a
# subclass of both module and the adjective class.
tmct:legacy a owl:Class ; rdfs:label "legacy" .
tmct:internal a owl:Class ; rdfs:label "internal" .
tmct:external a owl:Class ; rdfs:label "external" .
tmct:experimental a owl:Class ; rdfs:label "experimental" .
tmct:stable a owl:Class ; rdfs:label "stable" .

# ---------------------------------------------------------------------------
# 1c. Corpus relations (urn:tmct:mgx#) — the ConceptNet mirror.
#
#     25 of ConceptNet's 34 relations are mirrored into mgx: by camelCasing the
#     /r/ name (/r/CapableOf -> mgx:capableOf). Each cites its origin with
#     rdfs:seeAlso and nothing stronger: a ConceptNet /r/ URI names a relation
#     in a data model with no OWL semantics, so owl:equivalentProperty would
#     assert a shared property extension that ConceptNet never defined.
#     The row-by-row map is src/adapters/corpus/conceptnet-map.toml, which the
#     loader drift-checks; this section is the vocabulary's formal home.
#
#     Three relations deliberately do NOT mirror, because a standard term says
#     it better: /r/IsA and /r/DefinedAs land on rdfs:subClassOf, /r/DistinctFrom
#     on owl:disjointWith. Six emit no fact at all (see the TOML's ace = "none"
#     rows). ConceptNet's five deprecated negatives (/r/NotIsA, /r/NotDesires,
#     …) are not mirrored either: tmct negates with the mgxneg: prefix, which
#     covers every predicate rather than five hand-picked ones.
# ---------------------------------------------------------------------------

mgx:antonym a owl:ObjectProperty ;
  rdfs:label "antonym" ;
  rdfs:seeAlso cn:Antonym ;
  rdfs:comment "Corpus relation, mirrored from ConceptNet /r/Antonym: \"{start} is the opposite of {end}\"." .

mgx:atLocation a owl:ObjectProperty ;
  rdfs:label "atLocation" ;
  rdfs:seeAlso cn:AtLocation ;
  rdfs:comment "Corpus relation, mirrored from ConceptNet /r/AtLocation: \"you are likely to find a {start} in a {end}\"." .

mgx:capableOf a owl:ObjectProperty ;
  rdfs:label "capableOf" ;
  rdfs:seeAlso cn:CapableOf ;
  rdfs:comment "Corpus relation, mirrored from ConceptNet /r/CapableOf: \"a {start} can {end}\"." .

mgx:causes a owl:ObjectProperty ;
  rdfs:label "causes" ;
  rdfs:seeAlso cn:Causes ;
  rdfs:comment "Corpus relation, mirrored from ConceptNet /r/Causes: \"a {start} causes {end}\"." .

mgx:causesDesire a owl:ObjectProperty ;
  rdfs:label "causesDesire" ;
  rdfs:seeAlso cn:CausesDesire ;
  rdfs:comment "Corpus relation, mirrored from ConceptNet /r/CausesDesire: \"{start} makes you want to {end}\"." .

mgx:createdBy a owl:ObjectProperty ;
  rdfs:label "createdBy" ;
  rdfs:seeAlso cn:CreatedBy ;
  rdfs:comment "Corpus relation, mirrored from ConceptNet /r/CreatedBy: \"a {start} is created by a {end}\"." .

mgx:desires a owl:ObjectProperty ;
  rdfs:label "desires" ;
  rdfs:seeAlso cn:Desires ;
  rdfs:comment "Corpus relation, mirrored from ConceptNet /r/Desires: \"a {start} wants {end}\"." .

mgx:hasA a owl:ObjectProperty ;
  rdfs:label "hasA" ;
  rdfs:seeAlso cn:HasA ;
  rdfs:comment "Corpus relation, mirrored from ConceptNet /r/HasA: \"a {start} has a {end}\"." .

mgx:hasFirstSubevent a owl:ObjectProperty ;
  rdfs:label "hasFirstSubevent" ;
  rdfs:seeAlso cn:HasFirstSubevent ;
  rdfs:comment "Corpus relation, mirrored from ConceptNet /r/HasFirstSubevent: \"the first thing you do when you {start} is {end}\"." .

mgx:hasLastSubevent a owl:ObjectProperty ;
  rdfs:label "hasLastSubevent" ;
  rdfs:seeAlso cn:HasLastSubevent ;
  rdfs:comment "Corpus relation, mirrored from ConceptNet /r/HasLastSubevent: \"the last thing you do when you {start} is {end}\"." .

mgx:hasPrerequisite a owl:ObjectProperty ;
  rdfs:label "hasPrerequisite" ;
  rdfs:seeAlso cn:HasPrerequisite ;
  rdfs:comment "Corpus relation, mirrored from ConceptNet /r/HasPrerequisite: \"in order to {start}, you must {end}\"." .

mgx:hasProperty a owl:ObjectProperty ;
  rdfs:label "hasProperty" ;
  rdfs:seeAlso cn:HasProperty ;
  rdfs:comment "Corpus relation, mirrored from ConceptNet /r/HasProperty: \"a {start} is {end}\"." .

mgx:hasSubevent a owl:ObjectProperty ;
  rdfs:label "hasSubevent" ;
  rdfs:seeAlso cn:HasSubevent ;
  rdfs:comment "Corpus relation, mirrored from ConceptNet /r/HasSubevent: \"when you {start}, you {end}\"." .

mgx:locatedNear a owl:ObjectProperty ;
  rdfs:label "locatedNear" ;
  rdfs:seeAlso cn:LocatedNear ;
  rdfs:comment "Corpus relation, mirrored from ConceptNet /r/LocatedNear: \"a {start} is typically near a {end}\"." .

mgx:madeOf a owl:ObjectProperty ;
  rdfs:label "madeOf" ;
  rdfs:seeAlso cn:MadeOf ;
  rdfs:comment "Corpus relation, mirrored from ConceptNet /r/MadeOf: \"a {start} is made of {end}\"." .

mgx:mannerOf a owl:ObjectProperty ;
  rdfs:label "mannerOf" ;
  rdfs:seeAlso cn:MannerOf ;
  rdfs:comment "Corpus relation, mirrored from ConceptNet /r/MannerOf: \"{start} is a way to {end}\"." .

mgx:motivatedByGoal a owl:ObjectProperty ;
  rdfs:label "motivatedByGoal" ;
  rdfs:seeAlso cn:MotivatedByGoal ;
  rdfs:comment "Corpus relation, mirrored from ConceptNet /r/MotivatedByGoal: \"you would {start} because you want to {end}\"." .

mgx:obstructedBy a owl:ObjectProperty ;
  rdfs:label "obstructedBy" ;
  rdfs:seeAlso cn:ObstructedBy ;
  rdfs:comment "Corpus relation, mirrored from ConceptNet /r/ObstructedBy: \"{start} can be prevented by {end}\"." .

mgx:partOf a owl:ObjectProperty ;
  rdfs:label "partOf" ;
  rdfs:seeAlso cn:PartOf ;
  rdfs:comment "Corpus relation, mirrored from ConceptNet /r/PartOf: \"a {start} is part of a {end}\"." .

mgx:receivesAction a owl:ObjectProperty ;
  rdfs:label "receivesAction" ;
  rdfs:seeAlso cn:ReceivesAction ;
  rdfs:comment "Corpus relation, mirrored from ConceptNet /r/ReceivesAction: \"a {start} can be {end}\"." .

mgx:relatedTo a owl:ObjectProperty ;
  rdfs:label "relatedTo" ;
  rdfs:seeAlso cn:RelatedTo ;
  rdfs:seeAlso skos:related ;
  rdfs:comment "Corpus relation, mirrored from ConceptNet /r/RelatedTo: \"{start} is related to {end}\". Read as skos:related by the derived concept view (src/domain/skos-view.mjs), which mints the skos:Concept identity the bare stored strings lack; seeAlso, not subPropertyOf, because the property's stored domain/range are plain strings, not skos:Concept." .

mgx:similarTo a owl:ObjectProperty ;
  rdfs:label "similarTo" ;
  rdfs:seeAlso cn:SimilarTo ;
  rdfs:comment "Corpus relation, mirrored from ConceptNet /r/SimilarTo: \"{start} is similar to {end}\"." .

mgx:symbolOf a owl:ObjectProperty ;
  rdfs:label "symbolOf" ;
  rdfs:seeAlso cn:SymbolOf ;
  rdfs:comment "Corpus relation, mirrored from ConceptNet /r/SymbolOf: \"{start} is a symbol of {end}\"." .

mgx:synonym a owl:ObjectProperty ;
  rdfs:label "synonym" ;
  rdfs:seeAlso cn:Synonym ;
  rdfs:comment "Corpus relation, mirrored from ConceptNet /r/Synonym: \"{start} means the same as {end}\"." .

mgx:usedFor a owl:ObjectProperty ;
  rdfs:label "usedFor" ;
  rdfs:seeAlso cn:UsedFor ;
  rdfs:comment "Corpus relation, mirrored from ConceptNet /r/UsedFor: \"a {start} is used for {end}\"." .

